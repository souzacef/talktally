# Server-side only. Supply this value through the runtime environment.
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemini-3.5-flash
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
GOOGLE_TTS_VOICE=Kore
APP_TIME_ZONE=America/Sao_Paulo
DB_JDBC_URL=jdbc:postgresql://localhost:5432/talktally
DB_USERNAME=talktally
DB_PASSWORD=

# Generate a deployment secret with: openssl rand -base64 32
JWT_SECRET_BASE64=
JWT_ACCESS_TTL_SECONDS=3600
